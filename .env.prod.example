# Copier en .env.prod (ignoré par Git) et remplacer TOUTES les valeurs.
# Mots de passe : lettres et chiffres uniquement (ils sont insérés tels quels dans l'URI MongoDB).
APP_VERSION=1.1.1
MODEL_VERSION=1.0.0
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=aRemplacerParUnMotDePasseLong
MONGO_APP_USER=eligibilite_app
MONGO_APP_PASSWORD=aRemplacerParUnAutreMotDePasseLong
PROXY_PORT=8080
