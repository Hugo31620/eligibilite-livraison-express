# Copier en .env puis adapter (ou exporter les variables dans le shell).
# Aucun secret ici : les clés d'API vivent dans API_KEYS_FILE (local) ou Key Vault (cloud).
APP_ENV=dev                         # dev (SQLite, synthétique) | test | prod (MongoDB, ADR-0008)
MODEL_VERSION=1.0.0                 # version explicite du modèle servi (ADR-0002)
ARTIFACTS_DIR=artifacts             # racine des artefacts de modèle
ORDERS_DB_PATH=data/orders.db       # base SQLite des commandes (ADR-0001)
PREDICTION_THRESHOLD=0.5            # seuil de décision, à valider avec le métier
API_KEYS_FILE=secrets/api_keys.json # empreintes SHA-256 des clés (ADR-0007), hors Git
EXPOSE_API_DOCS=true                # false en production : ni /docs ni /openapi.json
SYNTHETIC_ROWS=6000                 # dev : taille du jeu synthétique d'entraînement

# Test / prod uniquement (APP_ENV=test|prod) : source ERP dans MongoDB (ADR-0008)
MONGO_URI=mongodb://localhost:27018 # compose de test ; en prod, fourni par .env.prod
MONGO_DATABASE=livraison_express
MONGO_SOURCE_COLLECTION=orders      # alimentée par l'ETL : lue, jamais modifiée
MONGO_ORDERS_COLLECTION=api_orders  # commandes reçues par POST /v1/orders
TRAINING_MIN_ROWS=200               # en dessous, l'entraînement s'arrête
